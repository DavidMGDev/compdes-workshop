# =============================================================================
#  Plantilla de variables de entorno — COMPDES 2026
# =============================================================================
#  CÓMO USAR:
#    1. Copie este archivo a «.env»  (sin el .example)
#         Linux/macOS:  cp .env.example .env
#         Windows PS:    Copy-Item .env.example .env
#    2. Pegue su llave en OPENAI_API_KEY.
#    3. NUNCA suba el .env a GitHub (ya está en .gitignore).
# =============================================================================

# --- Proveedor de LLM: Google AI Studio vía endpoint compatible con OpenAI ---
# Usamos el endpoint /openai/ de Google para que todo el código estándar de
# OpenAI funcione sin cambios. Verifique que esta ruta siga vigente el día del
# evento (Google la ha movido antes).
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Su llave. Las llaves modernas de AI Studio empiezan con «AQ.».
OPENAI_API_KEY=PEGUE_SU_LLAVE_AQUI

# --- Modelo (fijo para todo el taller) ---
# gemini-3.5-flash-lite: el modelo 3.5-class más rápido y económico de Google
# ($0.30 entrada / $2.50 salida por 1M tokens), afinado para flujos "agénticos"
# (uso de herramientas), que es justo lo que hace este taller. NO lo cambie:
# todo el material está calibrado a este modelo.
AGENT_MODEL=gemini-3.5-flash-lite

# --- Base de datos PostgreSQL del laboratorio (objetivo controlable) ---
POSTGRES_USER=onyx_app
POSTGRES_PASSWORD=app_password_123
POSTGRES_DB=distribuidora
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
